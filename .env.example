# ========================================================
# SMART HOSTEL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=smart_hostel_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# --------------------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------------------
# Set USE_POSTGRES=true when running against a live PostgreSQL database.
# If PostgreSQL is not reachable or USE_POSTGRES=false, the system automatically
# falls back to the embedded zero-config relational database (data/hostel.db).
USE_POSTGRES=false

# PostgreSQL Connection String (Optional, e.g. for Supabase / Neon / Local PG)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_hostel

# Individual PG Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=smart_hostel

# Embedded Relational Fallback Database
SQLITE_DB_PATH=./data/hostel.db

# Default Geofence Seed Coordinates (Campus Block A)
HOSTEL_LAT=11.016844
HOSTEL_LON=76.955832
HOSTEL_RADIUS=150.0
